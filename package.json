{
  "name": "hello-pear-electron",
  "productName": "HelloPear",
  "version": "1.0.0",
  "upgrade": "pear://xocjag4x5npi7tdp863yrg4mo7q41ht5jjwjknd7s19h83ack51o",
  "description": "",
  "license": "",
  "author": "",
  "type": "commonjs",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "inline-worker": "inline-worker-module hello-pear-worker",
    "lint": "prettier --check . && lunte",
    "format": "prettier --write . && lunte --fix",
    "start": "electron-forge start -- --no-updates",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mas": "electron-forge make --platform=mas",
    "install:all": "npm i --ignore-scripts=true && npm run postinstall:all",
    "install:mac": "npm i --ignore-scripts=true && npm run postinstall:mac",
    "postinstall:all": "npm run install:electron",
    "postinstall:mac": "npm run postinstall:all && npm run install:macos-alias && npm run install:fs-xattr",
    "install:electron": "node node_modules/electron/install.js",
    "install:macos-alias": "cd node_modules/macos-alias && node-gyp rebuild",
    "install:fs-xattr": "cd node_modules/fs-xattr && node-gyp rebuild",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "test:service": "node --test test/renderer-service.test.cjs",
    "test:ui": "vitest run --config vitest.config.mts",
    "test:peers": "node test/peer-sync.cjs",
    "test:update": "node --test test/update-request.test.cjs test/update-worker.test.cjs test/update-ui.test.cjs",
    "test:build": "node --test test/build-security.test.cjs",
    "test:bridge": "node --test test/preload.test.cjs",
    "test": "npm run test:service && npm run test:ui && npm run test:update && npm run test:build && npm run test:bridge",
    "test:worker": "node test/worker-smoke.cjs",
    "test:desktop": "node test/desktop-smoke.cjs"
  },
  "dependencies": {
    "autopass": "^3.4.1",
    "bare-path": "^3.1.2",
    "bare-storage": "^1.1.0",
    "corestore": "^7.15.0",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperswarm": "^4.17.2",
    "paparam": "^1.10.0",
    "pear-mobile": "^4.3.0",
    "pear-runtime": "^1.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-msix": "8.0.1",
    "@electron-forge/maker-pkg": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "app-builder-lib": "^26.8.1",
    "electron": "45.3.1",
    "electron-forge-plugin-prune-prebuilds": "2.0.0",
    "electron-forge-plugin-universal-prebuilds": "2.0.0",
    "hello-pear-worker": "^1.2.0",
    "inline-worker-module": "^1.0.0",
    "jsdom": "31.0.1",
    "lunte": "^1.6.0",
    "node-gyp": "12.4.0",
    "pear-electron-forge-maker-appimage": "3.0.1",
    "pear-electron-forge-maker-flatpak": "1.0.0",
    "pear-electron-forge-maker-snap": "2.0.0",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "yauzl": "3.3.1",
    "minimatch@>=7.0.0 <11.0.1": "11.0.8"
  },
  "allowScripts": {
    "electron@45.3.1": true,
    "electron-winstaller": false
  },
  "imports": {
    "pear-runtime": {
      "ios": "pear-mobile",
      "android": "pear-mobile",
      "simulator": "pear-mobile",
      "default": "pear-runtime"
    }
  }
}
